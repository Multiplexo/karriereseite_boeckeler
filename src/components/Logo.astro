---
import { site, url, inPublic } from '../lib/content';
// Logo im Header:
//  1. public/img/logo.svg/.png (komplettes Logo, falls ein Querformat-Logo geliefert wird)
//  2. sonst: rotes A aus dem Original-Logo (automatisch aus src/assets/roh/logo.* erzeugt) + Schriftzug
//  3. sonst: nur Schriftzug
const komplett = ['img/logo.svg', 'img/logo.png'].find(inPublic);
const zeichen = inPublic('img/logo-zeichen.png') ? 'img/logo-zeichen.png' : null;
---
<a class="logo" href={url()} aria-label={`${site.name} Erwitte – Karriere, zur Startseite`}>
  {komplett
    ? <img class="logo__img" src={url(komplett)} alt="" height="44" />
    : (
      <>
        {zeichen && <img class="logo__zeichen" src={url(zeichen)} alt="" height="40" />}
        <span class="logo__word">Laurentius<br />Apotheke<small>Karriere · Erwitte</small></span>
      </>
    )}
</a>
