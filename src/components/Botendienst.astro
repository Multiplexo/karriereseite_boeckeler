---
import { Picture } from 'astro:assets';
import { inhalte, sichtbar } from '../lib/content';
import { foto } from '../lib/bilder';
import Icon from './Icon.astro';
const b = sichtbar([inhalte.botendienst])[0];
const bild = b ? foto(b.foto) : null;
---
{b && (
<section class:list={['section', { draft: b.freigegeben === false }]} id="botendienst" aria-labelledby="bote-h">
  <div class="wrap bote">
    <figure class="bote__img">
      {bild
        // Oben-bündiger 16:9-Zuschnitt: Das Kfz-Kennzeichen unten rechts im Original wird so nicht ausgeliefert.
        ? <Picture src={bild} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 560px, 92vw" width={1200} height={675} fit="cover" position="top" alt={b.foto_alt} loading="lazy" />
        : <div class="bote__ph" aria-hidden="true"><Icon name="car" /></div>}
      {b.namen && <figcaption>{b.namen} · Botendienst</figcaption>}
    </figure>
    <div>
      <span class="eyebrow">Ein Team, das zusammen anpackt</span>
      <h2 id="bote-h">{b.titel}</h2>
      <p>{b.text}</p>
      <p><strong>{b.nutzen_bewerber}</strong></p>
    </div>
  </div>
</section>
)}
