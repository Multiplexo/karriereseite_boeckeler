---
import Foto from './Foto.astro';
import { inhalte, sichtbar } from '../lib/content';
interface Props { stelle?: string; titel?: string; text?: string; band?: string }
const t = inhalte.team;
const { stelle, titel = t.titel, text = t.text, band = 'band band--sand' } = Astro.props;
// Startseite: ohne Inhaberin (sie ist im Einstieg und im Abschluss zu sehen); Stellenseite: passende Kolleg:innen
const personen = sichtbar(t.personen).filter((p) => (stelle ? (p.stellen ?? []).includes(stelle) : p.startseite !== false));
const portraits = personen.filter((p) => !p.quer);
const quer = personen.filter((p) => p.quer);
const initialen = (n: string) => n.replace(/[^A-Za-zÄÖÜäöüß ]/g, '').trim().split(/\s+/).map((p) => p[0]).join('').slice(0, 2);
---
{personen.length > 0 && (
<section class={band} id="team" aria-labelledby="team-h">
  <div class="wrap">
    <div class="intro">
      <span class="kicker">Team</span>
      <h2 id="team-h">{titel}</h2>
      <p>{text}</p>
    </div>
    {portraits.length > 0 && (
      <div class="team">
        {portraits.map((p) => (
          <figure class:list={['person', { draft: p.freigegeben === false }]}>
            <Foto name={p.foto} alt={`Porträt ${p.name}, ${p.rolle}`} widths={[300, 480, 720]} sizes="(min-width: 900px) 370px, 78vw" platzhalter={initialen(p.name)} />
            <figcaption>
              <strong>{p.name}</strong>{p.rolle}{p.seit ? ` · ${p.seit}` : ''}
              {p.zitat && <q>{p.zitat}</q>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    {quer.map((p) => (
      <figure class:list={['person person--quer', { draft: p.freigegeben === false }]}>
        <Foto name={p.foto} alt={`${p.name}, ${p.rolle}`} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1180px) 1150px, 92vw" width={1600} height={686} position="top" />
        <figcaption><strong>{p.name}</strong>{p.rolle}</figcaption>
      </figure>
    ))}
  </div>
</section>
)}
