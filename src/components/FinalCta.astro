---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { foto } from '../lib/bilder';
import { site, inhalte, url, telHref, waHref, PRIMARY_CTA, sichtbar } from '../lib/content';
interface Props { stelle?: string }
const { stelle } = Astro.props;
const inh = site.inhaberin;
const zitat = sichtbar([inh.zitat])[0];
const bild = foto(inh.foto);
const init = inh.name.split(' ').map((p) => p[0]).join('');
---
<section class="section" aria-labelledby="final-h">
  <div class="wrap">
    <div class="final">
      {bild
        ? <figure class="final__portrait"><Picture src={bild} formats={['avif', 'webp']} widths={[160, 320]} sizes="160px" width={320} height={400} fit="cover" position="top" alt={`${inh.name}, ${inh.rolle}`} loading="lazy" /></figure>
        : <span class="portrait portrait--lg" aria-hidden="true">{init}</span>}
      <div>
        <h2 id="final-h">Lass uns sprechen.</h2>
        {zitat && (
          <blockquote class:list={{ draft: zitat.freigegeben === false }} style="margin:0 0 12px;font-size:1.1rem">
            <p style="margin:0;color:var(--c-text)">„{zitat.text}“</p>
            <footer class="microtext" style="margin-top:4px">– {inh.name}, {inh.rolle}</footer>
          </blockquote>
        )}
        <p>Ein paar Klicks genügen – wir melden uns innerhalb von 48 Stunden persönlich bei dir.</p>
        <div class="cta-group">
          <a class="btn btn--primary" href={url('bewerben/') + (stelle ? `?stelle=${stelle}` : '')} data-track="cta_click" data-pos="abschluss">{PRIMARY_CTA}</a>
          <a class="btn btn--outline" href={telHref} data-track="call_click" data-pos="abschluss"><Icon name="phone" /> {site.telefon_anzeige}</a>
          {waHref && <a class="btn btn--outline" href={waHref} data-track="whatsapp_click" data-pos="abschluss" rel="noopener"><Icon name="chat" /> WhatsApp</a>}
        </div>
        <p class="microtext">Lieber anrufen{waHref ? ' oder per WhatsApp schreiben' : ''}? {inhalte.hero.mikrotext}</p>
      </div>
    </div>
  </div>
</section>
