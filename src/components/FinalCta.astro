---
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import { site, inhalte, url, telHref, waHref, PRIMARY_CTA, sichtbar } from '../lib/content';
interface Props { stelle?: string }
const { stelle } = Astro.props;
const a = inhalte.abschluss;
const inh = site.inhaberin;
const zitat = sichtbar([a.zitat])[0];
const init = inh.name.split(' ').map((p) => p[0]).join('');
---
<section class="band band--sand" aria-labelledby="final-h">
  <div class="wrap final">
    <figure class="final__foto">
      <Foto name={inh.foto} nah alt={`${inh.name}, ${inh.rolle}`} widths={[320, 520, 840]} sizes="(min-width: 860px) 420px, 92vw" platzhalter={init} />
    </figure>
    <div class="final__text">
      <span class="kicker">Kontakt</span>
      <h2 id="final-h">{a.titel}</h2>
      {zitat && (
        <blockquote class:list={['final__zitat', { draft: zitat.freigegeben === false }]}>
          <p>„{zitat.text}“</p>
          <footer>{inh.name}, {inh.rolle}</footer>
        </blockquote>
      )}
      <p class="microtext" style="font-size:1.05rem">{a.text}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href={url('bewerben/') + (stelle ? `?stelle=${stelle}` : '')} data-track="cta_click" data-pos="abschluss">{PRIMARY_CTA}</a>
        <a class="btn btn--outline" href={telHref} data-track="call_click" data-pos="abschluss"><Icon name="phone" /> {site.telefon_anzeige}</a>
        {waHref && <a class="btn btn--outline" href={waHref} data-track="whatsapp_click" data-pos="abschluss" rel="noopener"><Icon name="chat" /> WhatsApp</a>}
      </div>
    </div>
  </div>
</section>
