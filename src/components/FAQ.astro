---
import { inhalte, sichtbar } from '../lib/content';
const f = inhalte.faq;
const eintraege = sichtbar(f.eintraege);
---
<section class="band" id="faq" aria-labelledby="faq-h">
  <div class="wrap faq-grid">
    <div class="intro">
      <span class="kicker">Fragen</span>
      <h2 id="faq-h">{f.titel}</h2>
    </div>
    <div class="faq">
      {eintraege.map((e) => (
        <details class:list={{ draft: e.freigegeben === false }}>
          <summary>{e.frage}</summary>
          <div><p>{e.antwort}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
