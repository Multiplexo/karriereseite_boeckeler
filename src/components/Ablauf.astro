---
import { inhalte, PREVIEW } from '../lib/content';
const a = inhalte.ablauf;
---
<section class="band band--sand" id="ablauf" aria-labelledby="ablauf-h">
  <div class="wrap">
    <div class="intro">
      <span class="kicker">Bewerbung</span>
      <h2 id="ablauf-h">{a.titel}</h2>
    </div>
    <ol class="ablauf">
      {a.schritte.map((s) => (
        <li class:list={{ draft: PREVIEW && !!s.text_entwurf }}>
          <span class="ablauf__zeit">{s.zeit}</span>
          <h3>{s.titel}</h3>
          <p>{PREVIEW && s.text_entwurf ? s.text_entwurf : s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
