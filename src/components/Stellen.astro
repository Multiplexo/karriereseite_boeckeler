---
import { offeneStellen, initiativ, gehaltSichtbar, url, PREVIEW } from '../lib/content';
interface Props { ohne?: string; titel?: string }
const { ohne, titel = 'Offene Stellen' } = Astro.props;
const liste = offeneStellen.filter((s) => s.slug !== ohne);
---
<section class="section" id="stellen" aria-labelledby="stellen-h">
  <div class="wrap">
    <span class="eyebrow">Alle (m/w/d)</span>
    <h2 id="stellen-h">{titel}</h2>
    <p class="section__intro">Such dir aus, was zu dir passt – die Bewerbung dauert keine 2 Minuten. Kein Anschreiben, kein Lebenslauf nötig.</p>
    <div class="grid grid--3">
      {liste.map((s) => {
        const g = gehaltSichtbar(s);
        return (
          <article class="card job">
            <h3><a href={url(`${s.slug}/`)} style="color:inherit;text-decoration:none">{s.titel} <span style="font-weight:500;color:var(--c-muted);font-size:.9rem">(m/w/d)</span></a></h3>
            <p style="margin:0">{s.kernbotschaft}</p>
            <ul class="job__facts">
              <li><strong>Umfang:</strong> {s.stundenumfang}</li>
              <li><strong>Start:</strong> {s.startdatum}</li>
              {g && <li class={PREVIEW && g.freigegeben === false ? 'draft' : undefined}><strong>Gehalt:</strong> {g.text}</li>}
            </ul>
            <details>
              <summary>Details</summary>
              <h4 style="margin:.4em 0 .2em">Deine Aufgaben</h4>
              <ul>{s.aufgaben.map((a) => <li>{a}</li>)}</ul>
              <h4 style="margin:.4em 0 .2em">Das bringst du mit</h4>
              <ul>{s.anforderungen.map((a) => <li>{a}</li>)}</ul>
              <a href={url(`${s.slug}/`)}>Zur Stellenseite</a>
            </details>
            <div class="job__actions">
              <a class="btn btn--primary" href={url(`bewerben/?stelle=${s.slug}`)} data-track="cta_click" data-pos={`karte-${s.slug}`}>Bewerben<span class="sr-only"> als {s.titel}</span></a>
            </div>
          </article>
        );
      })}
      <article class="card job job--initiativ">
        <h3>{initiativ.titel}</h3>
        <p style="margin:0">{initiativ.text}</p>
        <div class="job__actions">
          <a class="btn btn--outline" href={url('bewerben/?stelle=initiativ')} data-track="cta_click" data-pos="karte-initiativ">Initiativ bewerben</a>
        </div>
      </article>
    </div>
  </div>
</section>
