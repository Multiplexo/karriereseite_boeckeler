---
import '../styles/global.css';
import { site, url, PREVIEW, inPublic } from '../lib/content';
interface Props {
  title: string;
  description: string;
  path?: string;          // relativer Pfad innerhalb der Karriereseite für canonical
  ogImage?: string;       // relativer Pfad unter public/
  noindex?: boolean;
  jsonld?: object | object[];
}
const { title, description, path = '', ogImage = 'og/karriere.png', noindex = false, jsonld } = Astro.props;
const canonical = new URL(url(path), Astro.site).href;
const og = new URL(url(ogImage), Astro.site).href;
const plausible = site.analytics.plausible_domain;
// Favicon aus dem Original-Logo (scripts/bilder.mjs), sonst SVG-Platzhalter
const logoIcons = inPublic('favicon-32.png');
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(noindex || PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#ffffff" />
  {logoIcons ? (
    <>
      <link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32" />
      <link rel="icon" href={url('favicon-192.png')} type="image/png" sizes="192x192" />
      <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    </>
  ) : <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content={`${site.name} Erwitte`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {plausible && <script defer data-domain={plausible} src={site.analytics.plausible_src}></script>}
</head>
<body>
  <a class="skip" href="#main">Zum Inhalt springen</a>
  {PREVIEW && <div class="vorschau-banner">Vorschau: Gelb markierte Inhalte sind Entwürfe und erscheinen erst nach Freigabe.</div>}
  <slot name="header" />
  <main id="main"><slot /></main>
  <slot name="footer" />
  <script>
    import { initTracking } from '../scripts/tracking';
    initTracking();
  </script>
</body>
</html>
