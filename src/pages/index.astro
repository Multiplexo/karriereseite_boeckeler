---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RollenKacheln from '../components/RollenKacheln.astro';
import Tag from '../components/Tag.astro';
import Belege from '../components/Belege.astro';
import Team from '../components/Team.astro';
import Ehrlich from '../components/Ehrlich.astro';
import Angebot from '../components/Angebot.astro';
import Ablauf from '../components/Ablauf.astro';
import Standort from '../components/Standort.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
---
<Base
  title="Jobs in der Laurentius Apotheke Erwitte: PTA, PKA, Apotheker:in (m/w/d)"
  description="Hier hat Beratung Zeit und dein Feierabend eine Uhrzeit: PTA, PKA und Apotheker:innen in Erwitte gesucht. Inhabergeführt, um 18 Uhr ist Schluss. In 60 Sekunden bewerben."
>
  <Header slot="header" />
  <Hero />
  <RollenKacheln />
  <Tag />
  <Belege />
  <Team />
  <Ehrlich />
  <Angebot />
  <Ablauf />
  <Standort />
  <FAQ />
  <FinalCta />
  <Footer slot="footer" />
  <BottomBar slot="footer" />
</Base>
