---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/content';
---
<Base title="Seite nicht gefunden – Laurentius Apotheke Karriere" description="Diese Seite gibt es nicht (mehr)." noindex>
  <Header slot="header" />
  <section class="band"><div class="wrap prose">
    <h1>Diese Seite gibt es nicht (mehr)</h1>
    <p>Vielleicht ist die Stelle schon besetzt. Schau dir unsere offenen Stellen an – oder bewirb dich initiativ.</p>
    <p><a class="btn btn--primary" href={url()}>Zu den offenen Stellen</a></p>
  </div></section>
  <Footer slot="footer" />
</Base>
