# Nur die öffentlichen Endpunkte sind erreichbar.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(bewerbung|download)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(bewerbung|download)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
php_value upload_max_filesize 11M
php_value post_max_size 12M
